# Unit cube with full-texture UVs on every face (each side shows the whole image)
mtllib cube.mtl
o Cube
v 1.000000 -1.000000 -1.000000
v 1.000000 -1.000000 1.000000
v -1.000000 -1.000000 1.000000
v -1.000000 -1.000000 -1.000000
v 1.000000 1.000000 -0.999999
v 0.999999 1.000000 1.000001
v -1.000000 1.000000 1.000000
v -1.000000 1.000000 -1.000000
vt 0.000000 0.000000
vt 1.000000 0.000000
vt 1.000000 1.000000
vt 0.000000 1.000000
vn 0.000000 -1.000000 0.000000
vn 0.000000 1.000000 0.000000
vn 1.000000 0.000000 0.000000
vn -0.000000 0.000000 1.000000
vn -1.000000 -0.000000 -0.000000
vn 0.000000 0.000000 -1.000000
usemtl Material
s off
# Each face: two triangles, UVs = (BL 1)(BR 2)(TR 3)(TL 4) covering full 0..1
# bottom (vn1)
f 2/1/1 3/2/1 4/3/1
f 2/1/1 4/3/1 1/4/1
# top (vn2)
f 8/1/2 7/2/2 6/3/2
f 8/1/2 6/3/2 5/4/2
# +X (vn3)
f 5/1/3 6/2/3 2/3/3
f 5/1/3 2/3/3 1/4/3
# +Z (vn4)
f 6/1/4 7/2/4 3/3/4
f 6/1/4 3/3/4 2/4/4
# -X (vn5)
f 4/1/5 3/2/5 7/3/5
f 4/1/5 7/3/5 8/4/5
# -Z (vn6)
f 1/2/6 4/1/6 8/4/6
f 1/2/6 8/4/6 5/3/6
